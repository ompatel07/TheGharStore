{
  "name": "the-ghar-store",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "deploy": "shopify hydrogen deploy --assets-dir dist/client --worker-dir dist/server",
    "dev": "hydrogen skills check --mode=warn && vite dev",
    "dev:https": "hydrogen skills check --mode=warn && vite dev",
    "preview": "react-router build && vite preview",
    "typecheck": "react-router typegen && tsc && hydrogen gql check --fail-on-warn",
    "lint": "eslint .",
    "typecheck:win": "react-router typegen && tsc && node scripts/gql-check.mjs"
  },
  "dependencies": {
    "@remix-run/cookie": "^0.6.0",
    "@remix-run/session": "^0.4.2",
    "@shopify/hydrogen": "2026.10.2",
    "gsap": "^3.15.0",
    "isbot": "^5.1.36",
    "motion": "^14.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@react-router/dev": "7.18.4",
    "@shopify/cli": "4.8.1",
    "@shopify/mini-oxygen": "4.2.3",
    "@shopify/oxygen-workers-types": "^4.1.6",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "gql.tada": "^1.9.2",
    "graphql": "^16.13.2",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.0.3"
  },
  "engines": {
    "node": "^22.12 || ^24"
  }
}
